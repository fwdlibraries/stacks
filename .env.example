# Stacks configuration
# Copy to .env and fill in values:  cp .env.example .env
# Variable names map to backend/app/config.py (case-insensitive).

# --- Application -------------------------------------------------------------
# REQUIRED: generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DEBUG=false
# Encrypts stored credentials such as library API keys. Generate with:
#   docker compose ... exec app python -m app.cli generate-credentials-key
# Empty: derived from SECRET_KEY (then rotating SECRET_KEY means re-entering those keys).
CREDENTIALS_KEY=
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]

# --- Database (PostgreSQL + pgvector) -----------------------------------------
POSTGRES_USER=stacks
# REQUIRED: set a strong password (Docker Compose refuses to start without one)
POSTGRES_PASSWORD=
POSTGRES_DB=stacks
# The Docker Compose files build DATABASE_URL from the values above.
# Set it here only when running the backend outside Docker.
# DATABASE_URL=postgresql+asyncpg://stacks:<password>@localhost:5432/stacks
# Log every SQL statement with its parameters (local debugging only; includes secrets)
SQL_ECHO=false

# --- Redis --------------------------------------------------------------------
# REDIS_URL=redis://redis:6379/0

# --- Object storage (S3 or S3-compatible, e.g. MinIO) -------------------------
S3_BUCKET=stacks-files
S3_REGION=us-east-1
# Leave empty for AWS S3; set for MinIO or other S3-compatible services
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_EXPIRY=900

# --- Auth ---------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Failed password sign-ins per account before sign-in pauses, and for how long
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# --- LTI ----------------------------------------------------------------------
# 'database' or 'aws_secrets'
LTI_PRIVATE_KEY_STORAGE=database
# Public URL where browsers reach Stacks (LTI redirect_uri and registration URLs).
# Dev default: the Vite dev server, which proxies /lti and /api.
# Default for organizations without a domain (python -m app.cli configure-org).
PUBLIC_BASE_URL=http://localhost:5173
# LMS origins allowed to show Stacks in an iframe, space-separated, e.g.
# "https://lms.example.edu https://yourschool.instructure.com". Empty: same-origin only.
# Default for organizations that haven't set their own (configure-org --lms-origin).
FRAME_ANCESTORS=

# --- Organizations and hostnames -----------------------------------------------
# Requests belong to the organization whose domain matches the hostname
# (configure-org --add-domain). Other hostnames use DEFAULT_ORGANIZATION (a slug), if
# set. REQUIRE_KNOWN_HOST=true refuses them instead (hosted, multi-tenant setups).
DEFAULT_ORGANIZATION=
REQUIRE_KNOWN_HOST=false

# --- Citation lookup ----------------------------------------------------------
# Library systems (Alma, Primo) are configured per organization:
#   python -m app.cli configure-source --help
# Contact address sent to Crossref with lookups (its "polite pool"); optional.
# Default for organizations that haven't set their own (configure-org --contact-email).
METADATA_CONTACT_EMAIL=

# --- Z39.50 (YAZ sidecar gateway) ---------------------------------------------
YAZ_GATEWAY_URL=http://yaz:8080

# --- Email (optional) ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# --- Deployment ---------------------------------------------------------------
# Container image tag used by deploy/docker-compose.yml
STACKS_VERSION=latest

# --- Dev tunnel (optional) ----------------------------------------------------
# Serve the dev stack at a fixed public hostname through Cloudflare Tunnel, to test
# LTI launches and the browser extension. See the tunnel service in
# deploy/docker-compose.dev.yml. The token is a secret: never commit it.
# CLOUDFLARE_TUNNEL_TOKEN=
# (also set PUBLIC_BASE_URL=https://stacks-dev.example.org above)

# --- Host ports ---------------------------------------------------------------
# Uncomment to change the host side of published ports, e.g. when a native
# PostgreSQL/Redis or another web server already uses the default.
# HTTP_PORT=80
# HTTPS_PORT=443
# API_HOST_PORT=8000          # dev only
# FRONTEND_HOST_PORT=5173     # dev only
# DB_HOST_PORT=5432           # dev only
# REDIS_HOST_PORT=6379        # dev only
