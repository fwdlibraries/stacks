# Static file server for the built frontend (see Dockerfile `prod` stage).
# /api, /lti and TLS are handled by the edge proxy in deploy/nginx/nginx.conf,
# which also sends each organization's frame-ancestors policy with these pages.
# Don't set Content-Security-Policy here: a second policy would combine with the
# edge's and block LMS framing.
#
# add_header is repeated in each location because nginx drops server-level
# add_header directives in any location that sets its own.
server {
    listen 5173;
    server_name _;
    root /usr/share/nginx/html;

    # Hashed build assets never change; cache them for a long time
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Student list URLs load the lightweight public entry
    location /public/ {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri /public.html;
    }

    # Everything else is the editor SPA
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri /index.html;
    }
}
